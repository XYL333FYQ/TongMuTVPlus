# 复制为 .env 后填写。PASSWORD 是站长密码，必填，请用别处没用过的强密码。
USERNAME=admin
PASSWORD=
APP_PORT=3000
# 留空则在服务器上构建镜像；填 ghcr.io/<GitHub 用户名小写>/tongmutvplus:latest 则直接拉取构建好的镜像
TONGMU_IMAGE=
# Keep loopback behind an HTTPS reverse proxy; use 0.0.0.0 only when direct LAN access is intended.
BIND_ADDRESS=127.0.0.1
# Deployment commit/version marker returned by /health. Never put credentials here.
APP_COMMIT_SHA=unversioned
# Optional comma-separated public origins when proxy Host differs from browser Origin.
ROOM_ALLOWED_ORIGINS=
ROOM_MAX_OWNED=3
ROOM_MAX_MEMBERS=8
ROOM_MAX_QUEUE=200
ROOM_RECONNECT_GRACE_MS=30000
ROOM_OWNER_READY_MS=5000
ROOM_LEASE_MS=90000
ROOM_EMPTY_PAUSE_MS=60000
ROOM_SLEEP_MS=600000
ROOM_ARCHIVE_MS=2592000000
ROOM_PURGE_MS=604800000
ROOM_CHAT_RETENTION_MS=2592000000
# Optional credentials for external players. Website playback uses its login session.
# Keep these server-side; do not put the new proxy secret in a NEXT_PUBLIC variable.
PROXY_M3U8_TOKEN=
TVBOX_SUBSCRIBE_TOKEN=
PUID=1001
PGID=1001

# 登录 Cookie 签名密钥（与站长密码分开）。留空时 server.js 首次启动会自动生成并保存到数据目录的 auth-secret 文件，备份时请一起备份。
AUTH_SECRET=
# 外部触发定时任务 /api/cron/<CRON_PASSWORD> 的密码。留空时程序仍每小时自动执行，只是外部无法调用。
CRON_PASSWORD=
# 默认禁止代理接口访问内网地址（站长配置的直播源主机除外）。局域网 IPTV/Emby 等需要时改为 true。
ALLOW_PRIVATE_PROXY_TARGETS=false
